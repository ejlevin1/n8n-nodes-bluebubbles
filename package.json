{
	"name": "n8n-nodes-bluebubbles",
	"version": "0.1.1",
	"description": "n8n community nodes for BlueBubbles (self-hosted iMessage server): credential + auto-subscribing webhook trigger",
	"license": "MIT",
	"homepage": "https://github.com/ejlevin1/n8n-nodes-bluebubbles",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"bluebubbles",
		"imessage"
	],
	"author": {
		"name": "Eric LeVin",
		"email": "eric@ericlevin.me"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ejlevin1/n8n-nodes-bluebubbles.git"
	},
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "n8n-node build && node --test \"test/**/*.test.cjs\"",
		"hooks:install": "git config core.hooksPath .githooks",
		"dependencies": "git config core.hooksPath .githooks || echo Skipping git hooks install: not a git checkout",
		"prepublishOnly": "node -e \"console.error('Refusing to npm publish from the working tree. Releases are published by CI (release-please) from the packed tarball; for a manual publish run: npm pack, then npm publish ./n8n-nodes-bluebubbles-X.Y.Z.tgz --access public');process.exit(1)\""
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/BlueBubblesApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/BlueBubbles/BlueBubblesTrigger.node.js"
		]
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.3",
		"@commitlint/config-conventional": "21.2.3",
		"@n8n/node-cli": "0.52.3",
		"eslint": "9.39.5",
		"prettier": "3.9.10",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
